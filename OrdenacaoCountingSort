/*
 * Ordenacao por Counting Sort paralelo (OpenMP).
 *
 * Compilar (GCC / MinGW-w64 / Linux):
 *   gcc -O3 -march=native -fopenmp benchmark_ordenacao.c -o benchmark
 * Compilar (MSVC):
 *   cl /O2 /openmp /arch:AVX2 benchmark_ordenacao.c
 *
 * Executar:
 *   benchmark listaOdenada.txt
 */

#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <time.h>
#include <string.h>
#include <limits.h>

#ifdef _OPENMP
#include <omp.h>
#else
static int omp_get_thread_num(void)  { return 0; }
static int omp_get_num_threads(void) { return 1; }
static int omp_get_max_threads(void) { return 1; }
#endif

typedef int value_t;

#define MAX_T 256
#define ORCAMENTO_HIST ((size_t)512 << 20) /* limite de memoria dos histogramas */

/* ------------------------------------------------------------------ */
/* Utilidades                                                          */
/* ------------------------------------------------------------------ */

static double agora_ms(void) {
#ifdef _OPENMP
    return omp_get_wtime() * 1000.0;
#else
    return 1000.0 * (double)clock() / CLOCKS_PER_SEC;
#endif
}

static size_t particao(size_t n, int t, int nt) {
    return (size_t)((unsigned long long)n * (unsigned long long)t / (unsigned long long)nt);
}

static int threads_para(size_t n) {
    int T = omp_get_max_threads();
    size_t lim = n >> 15;
    if (lim < 1) lim = 1;
    if ((size_t)T > lim) T = (int)lim;
    if (T > MAX_T) T = MAX_T;
    if (T < 1) T = 1;
    return T;
}

static int esta_ordenado(const value_t *v, size_t n) {
    for (size_t i = 1; i < n; ++i)
        if (v[i - 1] > v[i]) return 0;
    return 1;
}

typedef struct { uint64_t soma, soma2; } Assinatura;

static Assinatura assinatura(const value_t *v, size_t n) {
    Assinatura a = {0, 0};
    for (size_t i = 0; i < n; ++i) {
        uint64_t x = (uint64_t)(int64_t)v[i];
        a.soma += x;
        a.soma2 += x * x;
    }
    return a;
}

static void minmax_par(const value_t *v, size_t n, int T, value_t *mn, value_t *mx) {
    value_t mins[MAX_T], maxs[MAX_T];
    int usados = 1;
#pragma omp parallel num_threads(T)
    {
        int t = omp_get_thread_num(), nt = omp_get_num_threads();
        size_t a = particao(n, t, nt), b = particao(n, t + 1, nt);
        value_t lo = INT_MAX, hi = INT_MIN;
        for (size_t i = a; i < b; ++i) {
            value_t x = v[i];
            lo = x < lo ? x : lo;
            hi = x > hi ? x : hi;
        }
        mins[t] = lo;
        maxs[t] = hi;
        if (t == 0) usados = nt;
    }
    value_t lo = mins[0], hi = maxs[0];
    for (int k = 1; k < usados; ++k) {
        if (mins[k] < lo) lo = mins[k];
        if (maxs[k] > hi) hi = maxs[k];
    }
    *mn = lo;
    *mx = hi;
}

/* ------------------------------------------------------------------ */
/* Leitura paralela do arquivo                                         */
/* ------------------------------------------------------------------ */

#define EH_TOKEN(c) ((((unsigned)(c) - '0') < 10u) || (c) == '-')

/* Cada thread processa os numeros cujo inicio cai em [lo, hi).
 * Com out == NULL apenas conta. */
static size_t varrer(const unsigned char *buf, size_t lo, size_t hi, value_t *out) {
    const unsigned char *p = buf + lo, *e = buf + hi;
    size_t cont = 0;
    if (lo > 0 && EH_TOKEN(buf[lo - 1]))
        while (p < e && EH_TOKEN(*p)) ++p;
    while (p < e) {
        unsigned c = *p;
        if (EH_TOKEN(c)) {
            int neg = 0;
            long long x = 0;
            if (c == '-') { neg = 1; ++p; }
            while (((unsigned)(*p) - '0') < 10u) {
                x = x * 10 + (*p - '0');
                ++p;
            }
            if (out) out[cont] = (value_t)(neg ? -x : x);
            ++cont;
        } else {
            ++p;
        }
    }
    return cont;
}

static value_t *carregar_arquivo(const char *caminho, size_t *n_out) {
    FILE *f = fopen(caminho, "rb");
    if (!f) return NULL;

#ifdef _WIN32
    _fseeki64(f, 0, SEEK_END);
    long long tam = _ftelli64(f);
    _fseeki64(f, 0, SEEK_SET);
#else
    fseek(f, 0, SEEK_END);
    long long tam = ftell(f);
    fseek(f, 0, SEEK_SET);
#endif
    if (tam < 0) { fclose(f); return NULL; }

    unsigned char *buf = (unsigned char *)malloc((size_t)tam + 1);
    if (!buf) { fclose(f); return NULL; }
    size_t lidos = fread(buf, 1, (size_t)tam, f);
    fclose(f);
    buf[lidos] = 0;

    int T = (lidos < ((size_t)1 << 20)) ? 1 : omp_get_max_threads();
    if (T > MAX_T) T = MAX_T;

    size_t cnt[MAX_T + 1], off[MAX_T + 1];
    value_t *dados = NULL;
    size_t total = 0;

#pragma omp parallel num_threads(T)
    {
        int t = omp_get_thread_num(), nt = omp_get_num_threads();
        size_t lo = particao(lidos, t, nt), hi = particao(lidos, t + 1, nt);
        cnt[t] = varrer(buf, lo, hi, NULL);
#pragma omp barrier
#pragma omp single
        {
            size_t acc = 0;
            for (int k = 0; k < nt; ++k) { off[k] = acc; acc += cnt[k]; }
            total = acc;
            dados = (value_t *)malloc((total ? total : 1) * sizeof(value_t));
        }
        if (dados) varrer(buf, lo, hi, dados + off[t]);
    }

    free(buf);
    *n_out = dados ? total : 0;
    return dados;
}

/* ------------------------------------------------------------------ */
/* Counting Sort paralelo                                              */
/* ------------------------------------------------------------------ */
/* Fases (em uma unica regiao paralela):
 *  1. cada thread zera e preenche o proprio histograma do seu bloco;
 *  2. cada thread soma os histogramas numa fatia da faixa de valores;
 *  3. prefixo sequencial minusculo entre as fatias;
 *  4. cada thread escreve sua fatia ja ordenada no vetor final.
 * Retorna -1 se a faixa de valores for grande demais para o Counting Sort. */
static int counting_sort(value_t *v, size_t n, uint32_t **hist, size_t *hist_cap) {
    if (n < 2) return 0;
    if (n >= 0xFFFFFFFFu) return -1;

    int T = threads_para(n);
    value_t mn, mx;
    minmax_par(v, n, T, &mn, &mx);

    uint64_t faixa = (uint64_t)((int64_t)mx - (int64_t)mn) + 1;
    if (faixa * sizeof(uint32_t) * (uint64_t)T > ORCAMENTO_HIST) return -1;

    size_t R = (size_t)faixa;
    size_t precisa = (size_t)T * R;
    if (*hist_cap < precisa) {
        free(*hist);
        *hist = (uint32_t *)malloc(precisa * sizeof(uint32_t));
        *hist_cap = *hist ? precisa : 0;
        if (!*hist) return -1;
    }
    uint32_t *H = *hist;

    uint32_t mnu = (uint32_t)mn;
    size_t fatia[MAX_T], desloc[MAX_T];

#pragma omp parallel num_threads(T)
    {
        int t = omp_get_thread_num(), nt = omp_get_num_threads();
        uint32_t *h = H + (size_t)t * R;
        memset(h, 0, R * sizeof(uint32_t));

        size_t a = particao(n, t, nt), b = particao(n, t + 1, nt);
        for (size_t i = a; i < b; ++i)
            h[(uint32_t)v[i] - mnu]++;
#pragma omp barrier

        size_t va = particao(R, t, nt), vb = particao(R, t + 1, nt);
        for (int k = 1; k < nt; ++k) {
            const uint32_t *hk = H + (size_t)k * R;
            for (size_t x = va; x < vb; ++x) H[x] += hk[x];
        }
        size_t soma = 0;
        for (size_t x = va; x < vb; ++x) soma += H[x];
        fatia[t] = soma;
#pragma omp barrier
#pragma omp single
        {
            size_t acc = 0;
            for (int k = 0; k < nt; ++k) { desloc[k] = acc; acc += fatia[k]; }
        }

        size_t pos = desloc[t];
        for (size_t x = va; x < vb; ++x) {
            uint32_t c = H[x];
            value_t val = (value_t)((uint32_t)x + mnu);
            for (uint32_t j = 0; j < c; ++j) v[pos + j] = val;
            pos += c;
        }
    }
    return 0;
}

/* ------------------------------------------------------------------ */

int main(int argc, char **argv) {
    const char *caminho = (argc >= 2) ? argv[1] : "listaOdenada.txt";

    size_t n = 0;
    value_t *dados = carregar_arquivo(caminho, &n);
    if (!dados) {
        fprintf(stderr, "Erro: nao foi possivel abrir/ler '%s'.\n", caminho);
        return 1;
    }
    if (n == 0) {
        fprintf(stderr, "Erro: nenhum numero inteiro encontrado no arquivo.\n");
        free(dados);
        return 1;
    }

    value_t *copia = (value_t *)malloc(n * sizeof(*copia));
    if (!copia) {
        fprintf(stderr, "Memoria insuficiente.\n");
        free(dados);
        return 1;
    }

    Assinatura ref = assinatura(dados, n);
    uint32_t *hist = NULL;
    size_t hist_cap = 0;

    /* aquecimento (threads, paginas, histogramas) - nao medido */
    memcpy(copia, dados, n * sizeof(*dados));
    if (counting_sort(copia, n, &hist, &hist_cap) != 0) {
        fprintf(stderr, "Erro: faixa de valores grande demais para o Counting Sort.\n");
        free(dados); free(copia); free(hist);
        return 1;
    }

    memcpy(copia, dados, n * sizeof(*dados));
    double t0 = agora_ms();
    counting_sort(copia, n, &hist, &hist_cap);
    double ms = agora_ms() - t0;

    Assinatura s = assinatura(copia, n);
    int correto = esta_ordenado(copia, n) && s.soma == ref.soma && s.soma2 == ref.soma2;
    if (!correto) {
        fprintf(stderr, "ERRO: a lista nao foi ordenada corretamente.\n");
        free(dados); free(copia); free(hist);
        return 2;
    }

    printf("Ordenacao: Counting Sort (paralelo)\n");
    printf("Elementos: %zu\n", n);
    printf("Threads:   %d\n", threads_para(n));
    printf("Tempo:     %.3f ms\n", ms);

    free(dados); free(copia); free(hist);
    return 0;
}
